# FastAPI AI 서버 설정 — 이 파일을 .env로 복사해 값을 채우세요.

# LLM (https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# 장소명 → 좌표 변환 (Google Cloud Console에서 Geocoding API 활성화)
GOOGLE_MAPS_API_KEY=

# Spring이 발급한 JWT 검증용 — backend의 JWT_SECRET과 같은 값
JWT_SECRET=

# 음식점 목록 수집(data/collect_restaurants.py)에만 필요한 Kakao REST API 키
KAKAO_API_KEY=

# Redis (기본값: localhost:6379, 비밀번호 없음)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
